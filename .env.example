# IP DERPer Plus 环境变量模板
#
# 用法：复制为 .env 后按需修改，docker compose 会自动读取
#   cp .env.example .env
#
# 注意：.env 含敏感信息（TS_AUTHKEY），.gitignore 已忽略它，不要提交到 git

# ---------------------------------------------------------------------------
# 必填：你的公网 IP 或域名
# ---------------------------------------------------------------------------
# 用 IP：客户端 DERPMap 里 HostName 填这个 IP，证书自动生成 IP 类型 SAN
# 用域名：证书自动生成 DNS 类型 SAN，可配正规证书也可用自签
DERP_HOST=

# ---------------------------------------------------------------------------
# 可选：监听与端口（一般不用改）
# ---------------------------------------------------------------------------
DERP_ADDR=:443
DERP_HTTP_PORT=80
DERP_STUN=true
DERP_STUN_PORT=3478

# ---------------------------------------------------------------------------
# 可选：DERP 与节点私钥路径（一般不用改）
# ---------------------------------------------------------------------------
# 这两个目录都挂在 named volume 上，容器重启/重建都不会丢
# DERP_CERTS=/app/certs
# DERP_CONFIG=/var/lib/derper/derper.key

# ---------------------------------------------------------------------------
# 防盗模式专用（仅 --profile anti-theft 时需要）
# ---------------------------------------------------------------------------
# 在 Tailscale 控制台生成 authkey，把 --auth-key 后的内容填在这里
# https://login.tailscale.com/admin/settings/keys
TS_AUTHKEY=

# TS_STATE_DIR=/var/lib/tailscale
# TS_EXTRA_ARGS=--advertise-tags=tag:container

# ---------------------------------------------------------------------------
# 证书强制重签（默认不填，保持已有证书）
# ---------------------------------------------------------------------------
# 证书默认复用已有文件，重启不重新签发。如果确实要换证书：
# FORCE_CERT_REGEN=1
