# IP DERPer Plus 环境变量模板
#
# 用法：复制为 .env 后按需修改，docker compose 会自动读取
#   cp .env.example .env
#
# ⚠️ .env 含敏感信息（TS_AUTHKEY），.gitignore 已忽略它，不要提交到 git
#
# ⚠️ 这里的每一项都会真正生效（compose 用 ${VAR:-默认} 引用）。
#    如果发现改了没反应，检查是不是被 shell 里的同名环境变量覆盖了
#    （优先级：shell 环境变量 > .env > compose 默认值）。

# ===========================================================================
# 必填
# ===========================================================================

# 公网 IP 或域名。客户端 DERPMap 里的 HostName 就填这个值。
#   用 IP   -> 证书自动生成 IP 类型 SAN
#   用域名 -> 证书自动生成 DNS 类型 SAN
DERP_HOST=

# 仅「带防盗」模板（docker-compose.yml）需要：Tailscale 控制台生成的 authkey
# https://login.tailscale.com/admin/settings/keys
# 把 --auth-key 后的内容填在这里。基础模板（docker-compose.basic.yml）不需要。
TS_AUTHKEY=

# ===========================================================================
# 监听与端口（一般不用改）
# ===========================================================================

# derper 的 HTTPS 监听地址
DERP_ADDR=:443

# 宿主机映射到容器 HTTPS 端口的端口号（443 需要 root/特权，冲突时可改）
DERP_HTTPS_PORT=443

# HTTP 端口，健康检查 /generate_204 挂在这里。设为 -1 关闭
DERP_HTTP_PORT=80

# 是否开启 STUN（UDP 打洞辅助）
DERP_STUN=true

# STUN 端口。⚠️ 是 UDP，防火墙要放行 udp 而不是 tcp
DERP_STUN_PORT=3478

# ===========================================================================
# 证书与节点私钥
# ===========================================================================

# 证书目录。⚠️ 若改动，必须同步修改 compose 里 volumes 的挂载点，否则重建即丢
DERP_CERTS=/app/certs

# derper 节点私钥文件。⚠️ 同上，所在目录 /var/lib/derper 必须挂持久卷
DERP_CONFIG=/var/lib/derper/derper.key

# 设为 1 强制重新签发证书。默认 0：证书已存在就复用，重启不换证
# （换证会让客户端 DERPMap 里的 CertName 哈希失效，非必要别开）
# FORCE_CERT_REGEN=0

# ===========================================================================
# 防盗（仅 docker-compose.yml 带防盗模板时生效）
# ===========================================================================

# 是否校验客户端归属同一 tailnet。默认 true（防盗模板）/ false（基础模板）
# DERP_VERIFY_CLIENTS=true

# tailscaled 状态目录，保存登录态，必须挂持久卷
TS_STATE_DIR=/var/lib/tailscale

# tailscale up 的附加参数
TS_EXTRA_ARGS=--advertise-tags=tag:container

# tailscaled 与 derper 通信的 socket 路径
TS_SOCKET=/var/run/tailscale/tailscaled.sock
